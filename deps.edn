{:paths ["src"]
 ;; langgraph brings langchain transitively (both zero-/single-dep,
 ;; all .cljc -> portable to JVM / SCI / ClojureScript / GraalVM). It lives
 ;; in the kotoba-lang org of this workspace (transferred + renamed from
 ;; com-junkawasaki/langgraph-clj / com-junkawasaki/langchain-clj).
 ;;
 ;; Like the fuel-wholesale / general-trading / metal-wholesale /
 ;; textile-wholesale / waste-wholesale / computer-and-software-wholesale
 ;; / ag-machinery-wholesale siblings, this precision-machinery-wholesale
 ;; vertical is SELF-CONTAINED: there is no `kotoba-lang/machtooltrade` to
 ;; delegate export-classification validation to, so the credit-clearance
 ;; / contract-on-file / capability-threshold / military-end-use /
 ;; sanctions-screening checks live as direct entity reads (some pure
 ;; computed range checks, some direct booleans) in
 ;; `machtooltrade.governor` rather than wrapping an external lib. This
 ;; repo is standalone (forkable outside the workspace); the :local/root
 ;; paths only resolve inside the monorepo checkout -- a standalone fork
 ;; should override them with git coordinates.
 ;; jp-go-digital-design-system (DADS) is the workspace's base design
 ;; system; `docs/samples/operator-console.html` is skinned with it via
 ;; `jp-go-dds.skin/dds+skin`. Pinned by :git/sha (not :local/root) so a
 ;; standalone fork can still render the console.
 :deps {
        ;; kotoba.lang.edn replaced clojure.edn here (2026-09-23). An explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, and kbb resolves git deps
        ;; only from nbb.edn, so every project file this repo has names it.
        io.github.kotoba-lang/edn
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "96a82d9612d7f3699f93323bad0c68355b8f7cc9"
         :deps/root "lib/kotoba.edn"}
       ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "96a82d9612d7f3699f93323bad0c68355b8f7cc9"
         :deps/root "lib/kotoba.test"}
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "96a82d9612d7f3699f93323bad0c68355b8f7cc9"
         :deps/root "lib/kotoba.text"}
       io.github.kotoba-lang/jp-go-digital-design-system
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "e09192276fd6a111dfb9959bfc75ddeba555e840"
         :deps/root "lib/kotoba.jpGoDigitalDesignSystem"}
        io.github.kotoba-lang/langgraph
        {:local/root "../../kotoba-lang/kotoba/lib/kotoba.langgraph"}
        io.github.kotoba-lang/langchain-store
        {:local/root "../../kotoba-lang/kotoba/lib/kotoba.langchainStore"}}
 :aliases
 {;; offline workspace dev -- pin transitive langchain to local checkout
  :dev {:override-deps
        {io.github.kotoba-lang/langchain
         {:local/root "../../kotoba-lang/langchain"}}}
  ;; kbb -M:dev:run  -> drive the demo through one OperationActor
  :run {:main-opts ["-m" "machtooltrade.sim"]}
  ;; kbb -M:dev:render-html [out-file] -> regenerate
  ;; docs/samples/operator-console.html by driving the REAL actor stack
  ;; (operation -> governor -> store). Throws rather than writing if the
  ;; run produces no HARD governor hold carrying a real violation.
  :render-html {:main-opts ["-m" "machtooltrade.render-html"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; static analysis -- clj-kondo from deps (no binary), errors fail CI.
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main"
                        "--lint" "src" "test"
                        "--fail-level" "error"]}}}
